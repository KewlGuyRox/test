# Legacy filename retained; the active display path is userspace spidev,
# not FBTFT/framebuffer. The build script enforces these options directly.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_MT7621=y
CONFIG_SPI_SPIDEV=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_EXPERT=y
# CONFIG_FB is not set
# CONFIG_FB_TFT is not set
# CONFIG_FB_TFT_ST7789V is not set
