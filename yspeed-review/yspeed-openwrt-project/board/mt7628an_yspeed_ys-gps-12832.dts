// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * YSPEED YS-GPS-12832 board DTS for OpenWrt 25.12.6.
 * Draft for source-build integration; must be compiled and reviewed before boot.
 *
 * Verified from vendor DTB / flash backup:
 *   MT7628AN; UART0 console 57600; UART1 GNSS; UART2 front-panel serial;
 *   PPS GPIO11 active-high; DS1307 @ 0x68; SH1106 @ 0x3c;
 *   W25Q256 32 MiB; firmware partition starts 0x50000 and is 0x1fb0000 bytes;
 *   switch0 VLAN1 ports 1-4 + CPU6 tagged; VLAN2 port0 + CPU6 tagged.
 *
 * Factory MAC note: captured /etc/config/network uses 60:70:72:59:22:0b.
 * The backed-up factory bytes place that address at factory-relative 0x2e;
 * 0x28 contains the adjacent address ending :0a. Use 0x2e for Ethernet.
 *
 * No Wi-Fi hardware/functionality is present. PCIe/WMAC remain disabled and
 * no wireless device nodes or wireless kernel packages are added.
 */

/dts-v1/;

#include "mt7628an.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
        model = "YSPEED YS-GPS-12832";
        compatible = "yspeed,ys-gps-12832", "YS-GPS-12832", "mediatek,mt7628an-soc";

        aliases {
                serial0 = &uartlite;
                serial1 = &uart1;
                serial2 = &uart2;
        };

        chosen {
                bootargs = "console=ttyS0,57600";
        };

        pps-gps {
                compatible = "pps-gpio";
                gpios = <&gpio 11 GPIO_ACTIVE_HIGH>;
                label = "pps-gps";
                status = "okay";
        };

        keys {
                compatible = "gpio-keys";
                #address-cells = <1>;
                #size-cells = <0>;
                poll-interval = <20>;

                reset {
                        label = "reset";
                        linux,code = <KEY_RESTART>;
                        gpios = <&gpio 38 GPIO_ACTIVE_LOW>;
                        debounce-interval = <60>;
                };
        };
};

/* Preserve the vendor pinmux for reset/WLAN-indicator pads. The WLAN LED
 * device itself is intentionally omitted because the board has no radio. */
&state_default {
        gpio {
                groups = "wdt", "wled_an";
                function = "gpio";
        };
};

&uartlite {
        status = "okay";
};

&uart1 {
        status = "okay";
};

&uart2 {
        status = "okay";
};

&i2c {
        status = "okay";

        rtc@68 {
                compatible = "dallas,ds1307";
                reg = <0x68>;
                status = "okay";
        };

        /* Preserve the exact vendor compatible until a mainline binding or
         * compatibility driver is selected and verified. */
        oled@3c {
                compatible = "wealth,sh1106";
                reg = <0x3c>;
                status = "okay";
        };
};

&spi0 {
        status = "okay";

        flash@0 {
                compatible = "jedec,spi-nor";
                reg = <0>;
                spi-max-frequency = <40000000>;

                partitions {
                        compatible = "fixed-partitions";
                        #address-cells = <1>;
                        #size-cells = <1>;

                        partition@0 {
                                label = "u-boot";
                                reg = <0x00000000 0x00030000>;
                                read-only;
                        };

                        partition@30000 {
                                label = "u-boot-env";
                                reg = <0x00030000 0x00010000>;
                                read-only;
                        };

                        partition@40000 {
                                label = "factory";
                                reg = <0x00040000 0x00010000>;
                                read-only;

                                nvmem-layout {
                                        compatible = "fixed-layout";
                                        #address-cells = <1>;
                                        #size-cells = <1>;

                                        macaddr_factory: mac-address@2e {
                                                reg = <0x2e 0x6>;
                                        };
                                };
                        };

                        partition@50000 {
                                compatible = "denx,uimage";
                                label = "firmware";
                                reg = <0x00050000 0x01fb0000>;
                        };
                };
        };
};

&gdma {
        status = "okay";
};

&ethernet {
        nvmem-cells = <&macaddr_factory>;
        nvmem-cell-names = "mac-address";
        status = "okay";
};

&esw {
        compatible = "mediatek,mt7628-esw", "ralink,rt3050-esw";
        status = "okay";
};

/* This is a wired-only board: do not enable radio buses or radio devices. */
&pcie {
        status = "disabled";
};

&wmac {
        status = "disabled";
};
