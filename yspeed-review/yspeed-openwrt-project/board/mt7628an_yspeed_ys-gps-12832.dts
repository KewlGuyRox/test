/* YSPEED YS-GPS-12832: MT7628AN, wired-only, RAM-boot profile. */
 /dts-v1/;
#include "mt7628an.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
        model = "YSPEED YS-GPS-12832";
        compatible = "yspeed,ys-gps-12832", "mediatek,mt7628an-soc";

        aliases {
                serial0 = &uartlite;
                serial1 = &uart1;
                serial2 = &uart2;
        };

        chosen { bootargs = "console=ttyS0,57600"; };

        pps-gps {
                compatible = "pps-gpio";
                gpios = <&gpio 11 GPIO_ACTIVE_HIGH>;
                label = "pps-gps";
                status = "okay";
        };

        keys {
                compatible = "gpio-keys";
                #address-cells = <1>;
                #size-cells = <0>;
                poll-interval = <20>;

                reset {
                        label = "reset";
                        linux,code = <KEY_RESTART>;
                        gpios = <&gpio 38 GPIO_ACTIVE_LOW>;
                        debounce-interval = <60>;
                };
                lcd-up {
                        label = "LCD Up";
                        linux,code = <KEY_UP>;
                        gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
                        debounce-interval = <30>;
                };
                lcd-enter {
                        label = "LCD Enter";
                        linux,code = <KEY_ENTER>;
                        gpios = <&gpio 23 GPIO_ACTIVE_LOW>;
                        debounce-interval = <30>;
                };
                lcd-down {
                        label = "LCD Down";
                        linux,code = <KEY_DOWN>;
                        gpios = <&gpio 26 GPIO_ACTIVE_LOW>;
                        debounce-interval = <30>;
                };
        };
};

&state_default {
        gpio {
                groups = "wdt", "wled_an";
                function = "gpio";
        };
};

&uartlite { status = "okay"; };
&uart1 { status = "okay"; };
&uart2 { status = "okay"; };

&i2c {
        status = "okay";
        rtc@68 {
                compatible = "dallas,ds1307";
                reg = <0x68>;
                status = "okay";
        };
};

&spi0 {
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <&spi_pins>, <&spi_cs1_pins>;

        flash@0 {
                compatible = "jedec,spi-nor";
                reg = <0>;
                spi-max-frequency = <40000000>;
                partitions {
                        compatible = "fixed-partitions";
                        #address-cells = <1>;
                        #size-cells = <1>;
                        partition@0 {
                                label = "u-boot";
                                reg = <0x00000000 0x00030000>;
                                read-only;
                        };
                        partition@30000 {
                                label = "u-boot-env";
                                reg = <0x00030000 0x00010000>;
                                read-only;
                        };
                        partition@40000 {
                                label = "factory";
                                reg = <0x00040000 0x00010000>;
                                read-only;
                                nvmem-layout {
                                        compatible = "fixed-layout";
                                        #address-cells = <1>;
                                        #size-cells = <1>;
                                        macaddr_factory: mac-address@2e {
                                                reg = <0x2e 0x6>;
                                        };
                                };
                        };
                        partition@50000 {
                                compatible = "denx,uimage";
                                label = "firmware";
                                reg = <0x00050000 0x01fb0000>;
                        };
                };
        };

        /*
         * The vendor firmware drives the colour ST7789 panel from userspace
         * through /dev/spidev0.1. D/C, reset and backlight are GPIO offsets
         * 16, 14 and 19; they are intentionally not claimed by kernel drivers.
         * CS1 is hardware SPI chip-select via spi_cs1_pins.
         */
        st7789@1 {
                compatible = "yspeed,st7789-spidev";
                reg = <1>;
                spi-max-frequency = <40000000>;
        };
};

&gdma { status = "okay"; };
&ethernet {
        nvmem-cells = <&macaddr_factory>;
        nvmem-cell-names = "mac-address";
        status = "okay";
};
&esw {
        compatible = "mediatek,mt7628-esw", "ralink,rt3050-esw";
        status = "okay";
};
&pcie { status = "disabled"; };
&wmac { status = "disabled"; };
