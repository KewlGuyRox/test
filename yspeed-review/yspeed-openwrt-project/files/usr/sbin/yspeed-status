#!/bin/sh
# Read-only YS-GPS-12832 telemetry snapshot. Shared by web UI and diagnostics.
#
# The satellites array is what the LCD mirrors: per-PRN signal strength and
# constellation, so the panel can draw the same bars the web page does.
#
# quality is defined as the mean SNR of satellites actually used for the fix,
# normalised to 50 dB-Hz (i.e. 30 dB-Hz average -> 60%). It is a presentation
# number, not a measurement of time accuracy.
set -u
get_json() {
    jsonfilter -s "$1" -e "@.$2" 2>/dev/null | head -n 1
}
json_string() {
    if [ -z "${1:-}" ] || [ "$1" = "n/a" ] || [ "$1" = "null" ]; then
        printf 'null'
    else
        printf '"%s"' "$(printf '%s' "$1" | tr '\r\n' '  ' | sed 's,\\,\\\\,g; s,",\\",g')"
    fi
}
json_number() {
    case "${1:-}" in
        ''|*[!0-9.+-]*) printf 'null' ;;
        *) printf '%s' "$1" ;;
    esac
}
gps_data=""
if command -v gpspipe >/dev/null 2>&1; then
    gps_data="$(timeout 2 gpspipe -w -n 80 2>/dev/null || true)"
fi
tpv="$(printf '%s\n' "$gps_data" | grep '"TPV"' | tail -n 1)"
sky="$(printf '%s\n' "$gps_data" | grep '"SKY"' | tail -n 1)"
mode="$(get_json "$tpv" mode)"
utc="$(get_json "$tpv" time)"
lat="$(get_json "$tpv" lat)"
lon="$(get_json "$tpv" lon)"
alt="$(get_json "$tpv" alt)"
speed="$(get_json "$tpv" speed)"
track="$(get_json "$tpv" track)"
hdop="$(get_json "$sky" hdop)"
vdop="$(get_json "$sky" vdop)"
pdop="$(get_json "$sky" pdop)"
case "$mode" in
    3) fix="3D" ;;
    2) fix="2D" ;;
    *) fix="NO_FIX" ;;
esac
utc_reported=false
[ -n "$utc" ] && [ "$utc" != "n/a" ] && utc_reported=true

# --- per-satellite detail -------------------------------------------------
prns="$(printf '%s\n' "$sky" | jsonfilter -e '@.satellites[*].PRN' 2>/dev/null || true)"
ss="$(printf '%s\n' "$sky" | jsonfilter -e '@.satellites[*].ss' 2>/dev/null || true)"
used="$(printf '%s\n' "$sky" | jsonfilter -e '@.satellites[*].used' 2>/dev/null || true)"
gnss="$(printf '%s\n' "$sky" | jsonfilter -e '@.satellites[*].gnssid' 2>/dev/null || true)"

sat_json="[]"
quality=0
used_count=0
visible_count=0
if [ -n "$prns" ]; then
    tmpd="$(mktemp -d 2>/dev/null || echo /tmp)"
    {
        printf '%s\n' "$prns"
        printf '^\n'
        printf '%s\n' "$ss"
        printf '^\n'
        printf '%s\n' "$used"
        printf '^\n'
        printf '%s\n' "$gnss"
    } | awk -v qfile="$tmpd/quality" '
        function num(v) { return (v ~ /^-?[0-9.]+$/) ? v + 0 : 0 }
        { if ($0 == "^") { section++; next } }
        section == 0 { prn[++np] = num($0); next }
        section == 1 { ss[++ns] = num($0); next }
        section == 2 { u[++nu] = ($0 ~ /true/) ? 1 : 0; next }
        section == 3 { g[++ng] = num($0); next }
        END {
            n = np
            count = 0
            sum = 0
            usedn = 0
            for (i = 1; i <= n; i++) {
                if (ss[i] > 0) count++
                if (u[i] == 1) { usedn++; sum += ss[i] }
            }
            q = (usedn > 0) ? int((sum / usedn) / 50 * 100) : 0
            if (q > 100) q = 100
            if (q < 0) q = 0
            printf "%d %d %d\n", q, usedn, count > qfile
            ORS = ""
            printf "["
            for (i = 1; i <= n; i++) {
                if (i > 1) printf ","
                printf "{\"prn\":%d,\"gnss\":%d,\"snr\":%d,\"used\":%s}", \
                    prn[i], g[i], ss[i], (u[i] == 1 ? "true" : "false")
            }
            printf "]"
            ORS = "\n"
        }' > "$tmpd/sats"
    sat_json="$(cat "$tmpd/sats" 2>/dev/null || echo '[]')"
    # Fail safe: anything that is not an array must not corrupt the document.
    case "$sat_json" in
        \[*\]) ;;
        *) sat_json="[]" ;;
    esac
    if [ -r "$tmpd/quality" ]; then
        read -r quality used_count visible_count < "$tmpd/quality" || true
    fi
    rm -rf "$tmpd" 2>/dev/null || true
fi
# Numeric guards: the web page and the LCD both parse these unquoted.
case "${quality:-0}" in ''|*[!0-9]*) quality=0 ;; esac
case "${used_count:-0}" in ''|*[!0-9]*) used_count=0 ;; esac
case "${visible_count:-0}" in ''|*[!0-9]*) visible_count=0 ;; esac

chrony="$(chronyc tracking 2>/dev/null || true)"
sources="$(chronyc sources -v 2>/dev/null || true)"
leap="$(printf '%s\n' "$chrony" | sed -n 's/^Leap status[[:space:]]*:[[:space:]]*//p' | head -n1)"
refid="$(printf '%s\n' "$chrony" | sed -n 's/^Reference ID[[:space:]]*:[[:space:]]*//p' | head -n1)"
stratum="$(printf '%s\n' "$chrony" | sed -n 's/^Stratum[[:space:]]*:[[:space:]]*//p' | head -n1)"
last_offset="$(printf '%s\n' "$chrony" | sed -n 's/^Last offset[[:space:]]*:[[:space:]]*//p' | head -n1)"
rms_offset="$(printf '%s\n' "$chrony" | sed -n 's/^RMS offset[[:space:]]*:[[:space:]]*//p' | head -n1)"
case "$leap" in
    Normal)
        if [ "$stratum" = "10" ]; then ntp_state="HOLDOVER"; else ntp_state="SYNCED"; fi
        ;;
    "Not synchronised") ntp_state="UNSYNCHRONISED" ;;
    "") ntp_state="CHRONY_UNAVAILABLE" ;;
    *) ntp_state="CHECK" ;;
esac
precision_eligible=false
case "$mode" in
    2|3)
        if printf '%s\n' "$sources" | grep -Eq '^#[*+][[:space:]]+PPS([[:space:]]|$)'; then
            precision_eligible=true
        fi
        ;;
esac
# NTP clients served (chrony's in-memory client table).
clients_raw="$(chronyc clients 2>/dev/null || true)"
clients_json="$(printf '%s\n' "$clients_raw" | awk '
    BEGIN { printf "["; sep = "" }
    /^Hostname/ || /^===/ || /^[[:space:]]*$/ { next }
    /^[0-9]+ Number/ { next }
    {
        host = $1; ntp = $2 + 0; drop = $3 + 0; last = $6;
        gsub(/\\/, "", host); gsub(/"/, "", host);
        if (host == "") next;
        printf "%s{\"host\":\"%s\",\"ntp\":%d,\"drop\":%d,\"last\":\"%s\"}", sep, host, ntp, drop, last;
        sep = ",";
    }
    END { printf "]" }')"
case "$clients_json" in \[*\]) ;; *) clients_json="[]" ;; esac

serverstats_raw="$(chronyc serverstats 2>/dev/null || true)"
ss_recv="$(printf '%s\n' "$serverstats_raw" | sed -n 's/^NTP packets received[[:space:]]*:[[:space:]]*//p' | head -n 1)"
ss_drop="$(printf '%s\n' "$serverstats_raw" | sed -n 's/^NTP packets dropped[[:space:]]*:[[:space:]]*//p' | head -n 1)"
ss_cmd="$(printf '%s\n' "$serverstats_raw" | sed -n 's/^Command packets received[[:space:]]*:[[:space:]]*//p' | head -n 1)"
case "$ss_recv" in ''|*[!0-9]*) ss_recv=0 ;; esac
case "$ss_drop" in ''|*[!0-9]*) ss_drop=0 ;; esac
case "$ss_cmd" in ''|*[!0-9]*) ss_cmd=0 ;; esac

# Antenna status from the ttyS2 reader, if it has seen a GPTXT sentence.
antenna_state=unknown
antenna_age=null
if [ -r /tmp/yspeed-antenna ]; then
    read -r antenna_state antenna_ts < /tmp/yspeed-antenna || true
    case "$antenna_state" in OK|OPEN|SHORT) ;; *) antenna_state=unknown ;; esac
    case "$antenna_ts" in ''|*[!0-9]*) ;;
        *)
            now_ts="$(date +%s 2>/dev/null || true)"
            case "$now_ts" in ''|*[!0-9]*) ;;
                *)
                    antenna_age=$((now_ts - antenna_ts))
                    [ "$antenna_age" -lt 0 ] && antenna_age=0
                ;;
            esac
        ;;
    esac
fi

# Display settings the daemon reads at startup.
display_rotation=3
display_sleep=120
display_language=english
if [ -r /etc/lvgl_st7789.conf ]; then
    while IFS='=' read -r dk dv; do
        dv="$(printf '%s' "$dv" | tr -d '\r')"
        case "$dk" in
            rotation) case "$dv" in 0|1|2|3) display_rotation=$dv ;; esac ;;
            backlight_sleep_time) case "$dv" in ''|*[!0-9]*) ;; *) display_sleep=$dv ;; esac ;;
            language) [ -n "$dv" ] && display_language=$dv ;;
        esac
    done < /etc/lvgl_st7789.conf
fi

pps_assert="$(cat /sys/class/pps/pps0/assert 2>/dev/null || true)"
pps_clear="$(cat /sys/class/pps/pps0/clear 2>/dev/null || true)"
rtc="$(hwclock -r 2>/dev/null || true)"
ip="$(ip -4 -o addr show dev eth0.2 2>/dev/null | awk '{print $4}' | head -n1)"
gateway="$(ip -4 route show default 2>/dev/null | awk '{print $3}' | head -n1)"
dns="$(awk '/^nameserver[[:space:]]/{printf "%s%s",sep,$2;sep=" "}' /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null)"
uptime="$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"
printf '{'
printf '"timestamp":'; json_string "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)"
printf ',"gnss":{"fix":"%s","mode":' "$fix"; json_number "$mode"
printf ',"utc":'; json_string "$utc"
printf ',"utc_reported":%s,"utc_precision_eligible":%s' "$utc_reported" "$precision_eligible"
printf ',"latitude":'; json_number "$lat"
printf ',"longitude":'; json_number "$lon"
printf ',"altitude_m":'; json_number "$alt"
printf ',"speed_mps":'; json_number "$speed"
printf ',"course_deg":'; json_number "$track"
printf ',"hdop":'; json_number "$hdop"
printf ',"vdop":'; json_number "$vdop"
printf ',"pdop":'; json_number "$pdop"
printf ',"satellites_reported":'; json_number "$visible_count"
printf ',"satellites_used":%d' "${used_count:-0}"
printf ',"quality":%d' "${quality:-0}"
printf ',"satellites":%s' "$sat_json"
printf '}'
printf ',"ntp":{"state":"%s","reference":' "$ntp_state"; json_string "$refid"
printf ',"stratum":'; json_number "$stratum"
printf ',"leap_status":'; json_string "$leap"
printf ',"last_offset":'; json_string "$last_offset"
printf ',"rms_offset":'; json_string "$rms_offset"
printf ',"tracking":'; json_string "$chrony"
printf ',"sources":'; json_string "$sources"
printf ',"clients":%s' "$clients_json"
printf ',"server_stats":{"received":%s,"dropped":%s,"cmd_received":%s}' "$ss_recv" "$ss_drop" "$ss_cmd"
printf '}'
printf ',"pps":{"device":%s,"assert":' "$([ -e /dev/pps0 ] && echo true || echo false)"
json_string "$pps_assert"
printf ',"clear":'; json_string "$pps_clear"; printf '}'
printf ',"antenna":{"state":"%s","age_seconds":%s}' "$antenna_state" "$antenna_age"
printf ',"display":{"rotation":%s,"backlight_sleep_time":%s,"language":' "$display_rotation" "$display_sleep"
json_string "$display_language"; printf '}'
printf ',"rtc":'; json_string "$rtc"
printf ',"network":{"interface":"eth0.2","ipv4":'; json_string "$ip"
printf ',"gateway":'; json_string "$gateway"
printf ',"dns":'; json_string "$dns"; printf '}'
printf ',"uptime_seconds":'; json_number "$uptime"
printf '}\n'
