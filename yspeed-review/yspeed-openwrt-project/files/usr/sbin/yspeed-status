#!/bin/sh
# Shared, short-lived telemetry cache for the LCD daemon and CGI endpoint.
# Both consumers read the same atomic JSON snapshot; only one refresh runs.
CACHE=/tmp/yspeed-status.json
LOCK=/tmp/yspeed-status.lock
WORKER=/usr/sbin/yspeed-status-refresh
MAX_AGE=2

fresh() {
    [ -s "$CACHE" ] || return 1
    now=$(date +%s)
    mtime=$(stat -c %Y "$CACHE" 2>/dev/null || echo 0)
    [ "$mtime" -gt 0 ] && [ $((now - mtime)) -le "$MAX_AGE" ]
}
if fresh; then
    cat "$CACHE"
    exit 0
fi

if mkdir "$LOCK" 2>/dev/null; then
    tmp="${CACHE}.$$"
    trap 'rm -f "$tmp"; rmdir "$LOCK" 2>/dev/null || true' EXIT HUP INT TERM
    if "$WORKER" >"$tmp" 2>/dev/null && [ -s "$tmp" ] &&
       grep -q '^{' "$tmp" && grep -q '"gnss":' "$tmp"; then
        chmod 0644 "$tmp"
        mv -f "$tmp" "$CACHE"
    fi
    if [ -s "$CACHE" ]; then
        cat "$CACHE"
        exit 0
    fi
    # A failed first refresh must still return live diagnostics, not silence.
    "$WORKER"
    exit $?
fi

# Another caller is refreshing. Briefly wait for its atomic publish, then use
# the last known snapshot if available; never launch a second slow GPS query.
tries=0
while [ "$tries" -lt 10 ]; do
    sleep 0.1
    if fresh; then cat "$CACHE"; exit 0; fi
    tries=$((tries + 1))
done
if [ -s "$CACHE" ]; then cat "$CACHE"; else "$WORKER"; fi
