#!/bin/sh /etc/rc.common
# yspeed-antenna: read the ATGM336H antenna-status sentence from ttyS2.
# Runs after the display so it cannot delay the machine's visible start-up.
START=96
STOP=11
USE_PROCD=1

PROG=/usr/sbin/yspeed-antenna

start_service() {
	if [ ! -c /dev/ttyS2 ]; then
		logger -t yspeed-antenna "no /dev/ttyS2; antenna status unavailable"
		return 0
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
