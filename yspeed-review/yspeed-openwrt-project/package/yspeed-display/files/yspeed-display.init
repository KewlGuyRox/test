#!/bin/sh /etc/rc.common
# yspeed-display: userspace ST7789 dashboard over /dev/spidev0.1.
#
# Rotation, language and backlight timeout come from /etc/lvgl_st7789.conf,
# which the ys-gps UCI config feeds. The daemon re-reads it on every restart.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/yspeed-display

start_service() {
	if [ ! -c /dev/spidev0.1 ]; then
		logger -t yspeed-display "no /dev/spidev0.1; display not started"
		return 0
	fi

	# The daemon reads this file; the comment above used to claim it was
	# generated, but nothing created it. Write the documented defaults once so
	# rotation and backlight behaviour are explicit and adjustable on the device.
	if [ ! -f /etc/lvgl_st7789.conf ]; then
		cat > /etc/lvgl_st7789.conf <<-EOF
		# written by /etc/init.d/yspeed-display on first start
		language=english
		rotation=3
		backlight_sleep_time=120
		EOF
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "ys-gps"
}

reload_service() {
	stop
	start
}
