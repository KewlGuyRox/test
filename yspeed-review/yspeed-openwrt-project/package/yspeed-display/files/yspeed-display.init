#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	[ -e /dev/fb0 ] || return 0
	# FBTFT registers the LED GPIO backlight initially powered off.
	for power in /sys/class/backlight/*/bl_power; do
		[ -e "$power" ] && echo 0 > "$power" 2>/dev/null || true
	done
	procd_open_instance
	procd_set_param command /usr/sbin/yspeed-display
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
