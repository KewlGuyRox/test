# Everything is text unless proven otherwise, and text is LF.
# The leading rule is required: extensionless scripts such as
# files/usr/sbin/yspeed-apply-update, files/etc/uci-defaults/9*, and
# files/www/cgi-bin/* cannot be matched by the extension rules below, and a
# CRLF shebang ("#!/bin/sh\r") fails to execute on OpenWrt.
* text=auto eol=lf

*.sh      text eol=lf
*.init    text eol=lf
*.py      text eol=lf
*.dts     text eol=lf
*.dtsi    text eol=lf
*.conf    text eol=lf
*.config  text eol=lf
*.mk      text eol=lf
*.md      text eol=lf

# Regenerated by the build or captured from the vendor; never text.
*.uImage  binary
*.dtb     binary
*.tar.gz  binary
*.bin     binary
*.gz      binary
*.pyc     binary
