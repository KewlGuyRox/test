# Keep build inputs on LF regardless of the committer's platform.
# A CRLF shebang ("#!/bin/sh\r") fails on OpenWrt and in CI, and CRLF in a
# .dts or Makefile produces confusing errors much later in the build.
*.sh      text eol=lf
*.init    text eol=lf
*.py      text eol=lf
*.dts     text eol=lf
*.dtsi    text eol=lf
*.conf    text eol=lf
*.config  text eol=lf
*.mk      text eol=lf

# Regenerated by the build; never text.
*.uImage  binary
*.dtb     binary
*.tar.gz  binary
*.bin     binary
